{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "test": "FIREBASE_CONFIG='{\"projectId\":\"hotel-suite-test\",\"storageBucket\":\"hotel-suite-test.appspot.com\"}' node --test src/*.node-test.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "pdfkit": "^0.17.2",
    "react": "^19.2.4",
    "resend": "^4.0.1",
    "sax": "^1.6.0",
    "ssh2-sftp-client": "^11.0.0",
    "svix": "^1.99.1"
  },
  "private": true
}
