{
  "policyVersion": 1,
  "coreFeatures": ["dashboard", "propertysettings", "imports", "integrations", "notifications", "users"],
  "modules": {
    "procurement": {
      "label": "Purchasing & Inventory",
      "features": ["catalogproducts", "supplierproducts", "suppliers", "orders", "stockcounts", "inventorymovements", "catalogsettings", "outlets", "locations", "purchaserequests", "purchasebudgets"],
      "roles": {
        "purchase-requester": {"label": "Purchase Requester", "permissions": ["purchaserequests.read", "purchaserequests.create", "purchaserequests.update", "purchaserequests.submit", "purchaserequests.cancel", "purchasebudgets.read", "suppliers.read", "supplierproducts.read", "outlets.read"]},
        "purchase-approver": {"label": "Purchase Approver", "permissions": ["purchaserequests.read", "purchaserequests.approve", "purchasebudgets.read"]},
        "budget-manager": {"label": "Budget Manager", "permissions": ["purchaserequests.read", "purchasebudgets.read", "purchasebudgets.update", "purchasebudgets.settings"]},
        "viewer": {"label": "Viewer", "permissions": ["catalogproducts.read", "supplierproducts.read", "suppliers.read", "orders.read", "stockcounts.read", "outlets.read", "locations.read", "catalogsettings.read", "inventorymovements.read"]},
        "buyer": {"label": "Buyer", "permissions": ["catalogproducts.read", "supplierproducts.read", "suppliers.read", "orders.read", "orders.create", "orders.update", "outlets.read", "catalogsettings.read"]},
        "approver": {"label": "Approver", "permissions": ["catalogproducts.read", "supplierproducts.read", "suppliers.read", "orders.read", "orders.approve", "outlets.read"]},
        "receiver": {"label": "Receiver", "permissions": ["orders.read", "orders.receive"]},
        "receiving-supervisor": {"label": "Receiving Supervisor", "permissions": ["orders.read", "orders.receive", "orders.finalize"]},
        "supplier-coordinator": {"label": "Supplier Coordinator", "permissions": ["orders.read", "orders.recordconfirmation"]},
        "supplier-response-reviewer": {"label": "Supplier Terms Approver", "permissions": ["orders.read", "orders.recordconfirmation", "orders.reviewconfirmation"]},
        "stock-controller": {"label": "Stock Controller", "permissions": ["supplierproducts.read", "suppliers.read", "orders.read", "stockcounts.read", "stockcounts.create", "stockcounts.update", "outlets.read", "locations.read", "inventorymovements.read", "inventorymovements.create"]},
        "module-manager": {"label": "Module Manager", "permissions": ["catalogproducts.read", "catalogproducts.create", "catalogproducts.update", "catalogproducts.delete", "supplierproducts.read", "supplierproducts.create", "supplierproducts.update", "supplierproducts.delete", "suppliers.read", "suppliers.create", "suppliers.update", "suppliers.delete", "suppliers.password", "orders.read", "orders.create", "orders.update", "orders.delete", "stockcounts.read", "stockcounts.create", "stockcounts.update", "stockcounts.delete", "catalogsettings.read", "catalogsettings.create", "catalogsettings.update", "catalogsettings.delete", "outlets.read", "outlets.create", "outlets.update", "outlets.delete", "outlets.approvers", "locations.read", "locations.create", "locations.update", "locations.delete", "inventorymovements.read", "inventorymovements.create"]},
        "inventory-supervisor": {"label": "Inventory Supervisor", "permissions": ["stockcounts.read", "inventorymovements.read", "inventorymovements.create", "inventorymovements.reverse"]}
      }
    },
    "contracts": {"label": "Contract Management", "features": ["contracts"], "roles": {}},
    "frontoffice": {"label": "Front Office & Upselling", "features": ["reservations", "auditupsells"], "roles": {}},
    "groups": {"label": "Groups & Events", "features": ["groups", "roominglists"], "roles": {}},
    "revenue": {"label": "Revenue & Forecasting", "features": ["groupquotes", "demandcalendar", "commercialintelligence"], "roles": {}}
  }
}
