PRODUCTION_FIREBASE_PROJECT_ID=

# Optional public landing-page contact. These values are visible in the browser.
# Leave unset to keep the local product-preview actions. HTTPS booking URL wins.
VITE_PUBLIC_DEMO_URL=
VITE_PUBLIC_CONTACT_EMAIL=

# Staging also requires the reviewed source commit (full 40-character SHA):
# RELEASE_TARGET=staging
# VITE_RELEASE_SHA=
