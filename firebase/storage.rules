rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function boundedUpload() {
      return request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024;
    }
    function productImageUpload() {
      return boundedUpload() && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    }
    function importUpload() {
      return boundedUpload() && request.resource.contentType in ['text/csv', 'text/plain', 'application/pdf', 'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', 'application/xml', 'text/xml', 'application/json'];
    }

    function isPlatformAdmin() {
      return signedIn()
        && 'platformAdmin' in request.auth.token
        && request.auth.token.platformAdmin == true;
    }

    // BEGIN GENERATED MODULE POLICY: scripts/render-module-rules.mjs
    function hasModule(subscription, moduleId) {
      let modules = subscription.modules;
      return subscription.modulePolicyVersion == 1
        && modules is list && modules.size() <= 5
        && modules.hasOnly(['procurement', 'contracts', 'frontoffice', 'groups', 'revenue'])
        && modules.toSet().size() == modules.size()
        && (moduleId == 'core' || moduleId in modules);
    }
    function featureModule(feature) {
      return feature in ['catalogproducts', 'supplierproducts', 'suppliers', 'orders', 'stockcounts', 'catalogsettings', 'outlets', 'locations'] ? 'procurement' :
        feature in ['contracts'] ? 'contracts' :
        feature in ['reservations', 'auditupsells'] ? 'frontoffice' :
        feature in ['groups', 'roominglists'] ? 'groups' :
        feature in ['groupquotes', 'demandcalendar', 'commercialintelligence'] ? 'revenue' :
        feature in ['dashboard', 'propertysettings', 'imports', 'integrations', 'notifications', 'users'] ? 'core' : 'unsupported';
    }
    // END GENERATED MODULE POLICY

    function hasActiveSubscription(subscription) {
      return subscription.status in ['active', 'trialing']
        && ((subscription.status == 'active' && subscription.validUntil == null)
          || (subscription.validUntil is timestamp && subscription.validUntil > request.time));
    }

    function hotelPermission(hotelUid, feature, action) {
      let subscription = firestore.get(/databases/(default)/documents/hotelSubscriptions/$(hotelUid)).data;
      let member = firestore.get(/databases/(default)/documents/hotels/$(hotelUid)/members/$(request.auth.uid)).data;
      return hasActiveSubscription(subscription) && hasModule(subscription, featureModule(feature))
        && member.permissions is list && member.permissions.hasAny([feature + '.' + action, feature + '.*']);
    }
    function hasPermission(hotelUid, feature, action) {
      return isPlatformAdmin() || (signedIn() && hotelPermission(hotelUid, feature, action));
    }

    // Private contract objects and legacy paths cannot expose metadata or mint
    // download tokens through the browser SDK, even to platform administrators.
    match /private/contracts/{allPaths=**} { allow read, write: if false; }
    match /hotels/{hotelUid}/contracts/{allPaths=**} { allow read, write: if false; }

    match /hotels/{hotelUid}/catalogproducts/{allPaths=**} {
      allow read: if hasPermission(hotelUid, 'catalogproducts', 'read');
      allow create: if (hasPermission(hotelUid, 'catalogproducts', 'create') || hasPermission(hotelUid, 'catalogproducts', 'update')) && productImageUpload();
      allow update: if hasPermission(hotelUid, 'catalogproducts', 'update') && productImageUpload();
      allow delete: if hasPermission(hotelUid, 'catalogproducts', 'delete');
    }

    match /hotels/{hotelUid}/supplierproducts/{allPaths=**} {
      allow read: if hasPermission(hotelUid, 'supplierproducts', 'read');
      allow create: if (hasPermission(hotelUid, 'supplierproducts', 'create') || hasPermission(hotelUid, 'supplierproducts', 'update')) && productImageUpload();
      allow update: if hasPermission(hotelUid, 'supplierproducts', 'update') && productImageUpload();
      allow delete: if hasPermission(hotelUid, 'supplierproducts', 'delete');
    }

    match /hotels/{hotelUid}/{collectionName}/{allPaths=**} {
      allow read, delete: if isPlatformAdmin() && collectionName != 'contracts';
      allow create, update: if isPlatformAdmin() && !(collectionName in ['contracts', 'catalogproducts', 'supplierproducts']) && boundedUpload();
    }

    match /imports/{hotelUid}/{allPaths=**} {
      allow read: if hasPermission(hotelUid, 'imports', 'read');
      allow create, update: if hasPermission(hotelUid, 'imports', 'execute') && importUpload();
      allow delete: if hasPermission(hotelUid, 'imports', 'execute');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
