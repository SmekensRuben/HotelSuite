{
  "name": "breakfastpilot",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": "10.9.9"
  },
  "scripts": {
    "test": "vitest src",
    "test:security": "firebase emulators:exec --project demo-hotel-suite-a00 --only auth,firestore,storage \"node --test --test-concurrency=1 tests/security/*.test.mjs\"",
    "test:restore": "bash scripts/firebase/emulator-restore-smoke.sh",
    "audit:policy": "node scripts/check-dependency-audit.mjs",
    "dev": "vite",
    "validate:env": "node scripts/validate-client-environment.mjs",
    "build": "npm run validate:env && vite build",
    "apphosting:build": "node scripts/build-apphosting.mjs",
    "build:apphosting": "npm run apphosting:build",
    "start": "node scripts/serve-app.mjs",
    "build:test": "NODE_ENV=test npm run validate:env && vite build --mode test",
    "preview": "vite preview",
    "lint": "eslint src functions/src functions/index.js scripts",
    "typecheck": "tsc --project tsconfig.boundaries.json"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.3",
    "chart.js": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "framer-motion": "^12.9.4",
    "fuse.js": "^7.1.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.1.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.506.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.5.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.3",
    "react-toastify": "^11.0.5",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.14",
    "babel-jest": "^29.7.0",
    "eslint": "^10.12.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.9.3",
    "vite": "^4.3.9",
    "vitest": "^3.1.4"
  },
  "main": "postcss.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmekensRuben/KitchenPilot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SmekensRuben/KitchenPilot/issues"
  },
  "homepage": "https://github.com/SmekensRuben/KitchenPilot#readme",
  "description": "",
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
